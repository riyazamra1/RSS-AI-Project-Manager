# RSS AI Project Manager - AI provider configuration example
# Copy these values into the server's secret/environment configuration.
# NEVER commit real credentials.

AI_PRIMARY_PROVIDER=codex
AI_FALLBACK_PROVIDER=gemini

# Codex / OpenAI-compatible coding provider
CODEX_API_KEY=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional future providers
# LOCAL_AI_BASE_URL=
# LOCAL_AI_MODEL=
